# 测试与调试脚本用的本地配置
#
# 复制成 .env 再填自己的值。.env 已在 .gitignore 里，不会进版本库，也不随 npm 包发布。
# 这些值只给 test/ 下需要真实调用接口的脚本用；节点本身从「钉钉连接」配置节点读凭证。

# 应用凭证（开发者后台 → 凭证与基础信息）
DT_CLIENT_ID=
DT_CLIENT_SECRET=
DT_ROBOT_CODE=

# 卡片模板 ID（卡片平台里那个 xxx.schema）
CARD_TEMPLATE_ID=

# 测试用的群 ID 与接收人 userid
OPEN_CONVERSATION_ID=
TEST_USER_ID=

# 设成 1 打开测试脚本的额外输出
DEBUG=
