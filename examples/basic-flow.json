    {
        "id": "a1b2c3d4e5f60005",
        "type": "function",
        "z": "a1b2c3d4e5f60001",
        "name": "组装卡片变量",
        "func": "// 模板里的变量名必须和卡片模板一致\nmsg.cardParamMap = {\n    title: '统计数据',\n    content: '应 ' + (msg.dingtalk.senderNick || '同事') + ' 的请求生成',\n    status: '待确认',\n    operator: ''\n};\n// conversationId 直接在 msg.conversationId 上，发卡片节点会优先用它\nreturn msg;",
        "outputs": 1,
        "x": 410,
        "y": 100,
        "wires": [
            [
                "a1b2c3d4e5f60004"
            ]
        ]
    },
    {
        "id": "a1b2c3d4e5f60004",
        "type": "dingtalk-card-send",
        "z": "a1b2c3d4e5f60001",
