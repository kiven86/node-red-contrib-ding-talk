        "type": "function",
        "z": "a1b2c3d4e5f60001",
        "name": "转成回复文本",
        "func": "// msg.conversationId 由「收到消息」节点带下来，直接回复到同一个会话\nmsg.payload = '收到：' + msg.payload;\nreturn msg;",
        "outputs": 1,
