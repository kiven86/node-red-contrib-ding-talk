  {
    "id": "f1c0de0000000004",
    "type": "function",
    "z": "f1c0de0000000001",
    "name": "按 action 组装回显",
    "func": "// 卡片按钮回调 → 组装要回写的卡片变量\n// msg.dingtalk.params 里是模板按钮配置的参数，例如 { action: 'agree' }\nconst d = msg.dingtalk || {};\nconst params = d.params || {};\nconst action = String(params.action || d.actionParam || d.actionId || '').trim();\n\nconst LABEL = {\n  agree: '✅ 已通过',\n  reject: '❌ 已驳回',\n  done: '已处理',\n};\n\n// ⚠️ 下面这几个变量名必须和卡片模板里的变量名一致，按你的模板改\nmsg.payload = {\n  status: LABEL[action] || (action ? '已处理：' + action : '已处理'),\n  result: '操作人 ' + (d.userId || '') + ' · ' + new Date().toLocaleString('zh-CN', { hour12: false }),\n};\n\nmsg.action = action;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
